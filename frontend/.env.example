# ---------------------------------------------------------------
# AI Knowledge Base — frontend environment
# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser,
# so never put the Supabase service key or OpenAI key here.
# ---------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Must match the backend's MAX_UPLOAD_SIZE_MB (checked again by the backend).
NEXT_PUBLIC_MAX_UPLOAD_MB=20
