# ---------------------------------------------------------------
# AI Knowledge Base — backend environment
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------

# App
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Supabase (backend-only — the service key must never reach the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Direct Postgres connection string (Supabase > Project Settings > Database)
DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
