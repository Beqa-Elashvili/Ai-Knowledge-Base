# ---------------------------------------------------------------
# AI Knowledge Base — backend environment
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------

# App
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Supabase (backend-only — the service key must never reach the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Postgres connection string: Supabase > Connect > Session pooler
# (the direct connection is IPv6-only). Note the postgresql+psycopg prefix.
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Storage / uploads (optional — defaults shown)
STORAGE_BUCKET=documents
# Raising this above 20 also requires raising the bucket file_size_limit
# (see supabase/migrations/0002_storage.sql).
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=2000
SIGNED_URL_EXPIRES_SECONDS=3600

# Chunking (characters; overlap must be < half the chunk size)
CHUNK_SIZE=1600
CHUNK_OVERLAP=200

# Embeddings: gemini (free tier, https://aistudio.google.com/apikey) or openai.
# EMBEDDING_MODEL empty = provider default (gemini-embedding-2 / text-embedding-3-small).
# Switching provider or model? Re-embed stored chunks: python -m scripts.reembed --all
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=100

# Vector search: chunks per question, minimum cosine similarity (0-1)
SEARCH_TOP_K=5
SEARCH_MIN_SIMILARITY=0.0

# AI provider keys (only the selected provider's key is required)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=sk-your-openai-api-key
